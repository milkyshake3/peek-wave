# =============================================================================
# Peek Wave — Git Ignore Specification (.gitignore)
# =============================================================================


# --- Chromium & Browser Extension Artifacts ---
_metadata/
*.crx
*.pem
*.zip

# --- Node & Dependency Artifacts ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
package-lock.json

# --- Testing, Coverage & Build Artifacts ---
scripts/
coverage/
.nyc_output/
*.lcov
test-results/
report.html
*.tmp.js
*.test.log

# --- Runtime Logs, Dumps & Scratch Files ---
*.log
logs/
*.tmp
*.temp
*.swp
*.swo
*~
scratch/
scratch.*
temp/
tmp/

# Hidden workspace & cache files
*_FUTURE.md

# --- IDE & Editor Metadata ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Operating System Artifacts ---
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
.directory

# --- Python Artifacts (Test Infrastructure) ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# --- Environment & Local Overrides ---
.env
.env.local
.env.*.local
