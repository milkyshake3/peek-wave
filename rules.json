[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "modifyHeaders",
      "responseHeaders": [
        {
          "header": "X-Frame-Options",
          "operation": "remove"
        },
        {
          "header": "Frame-Options",
          "operation": "remove"
        },
        {
          "header": "Content-Security-Policy",
          "operation": "remove"
        },
        {
          "header": "Content-Security-Policy-Report-Only",
          "operation": "remove"
        },
        {
          "header": "Cross-Origin-Opener-Policy",
          "operation": "remove"
        },
        {
          "header": "Cross-Origin-Opener-Policy-Report-Only",
          "operation": "remove"
        },
        {
          "header": "Cross-Origin-Embedder-Policy",
          "operation": "remove"
        },
        {
          "header": "Cross-Origin-Embedder-Policy-Report-Only",
          "operation": "remove"
        },
        {
          "header": "Document-Isolation-Policy",
          "operation": "remove"
        }
      ]
    },
    "condition": {
      "urlFilter": "*",
      "resourceTypes": [
        "sub_frame"
      ]
    }
  },
  {
    "id": 2,
    "priority": 1,
    "action": {
      "type": "block"
    },
    "condition": {
      "urlFilter": "||abs.twimg.com/responsive-web/client-serviceworker/*",
      "resourceTypes": [
        "script",
        "xmlhttprequest"
      ]
    }
  },
  {
    "id": 3,
    "priority": 2,
    "action": {
      "type": "modifyHeaders",
      "requestHeaders": [
        {
          "header": "Sec-Fetch-Dest",
          "operation": "set",
          "value": "document"
        },
        {
          "header": "Sec-Fetch-Mode",
          "operation": "set",
          "value": "navigate"
        }
      ]
    },
    "condition": {
      "urlFilter": "*",
      "excludedRequestDomains": [
        "youtube.com",
        "youtube-nocookie.com",
        "youtu.be",
        "googlevideo.com",
        "accounts.google.com",
        "doubleclick.net",
        "googlesyndication.com"
      ],
      "resourceTypes": [
        "sub_frame"
      ]
    }
  },
  {
    "id": 4,
    "priority": 3,
    "action": {
      "type": "modifyHeaders",
      "requestHeaders": [
        {
          "header": "Referer",
          "operation": "set",
          "value": "https://peekwave.app/"
        }
      ]
    },
    "condition": {
      "urlFilter": "/embed/",
      "requestDomains": [
        "youtube-nocookie.com",
        "youtube.com"
      ],
      "initiatorDomains": [
        "youtube.com",
        "youtu.be",
        "youtube-nocookie.com"
      ],
      "resourceTypes": [
        "sub_frame"
      ]
    }
  }
]
